{
  "name": "sf6-frame-guess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:data": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:archive": "node --test --test-concurrency=1 archive/tests/*.test.mjs",
    "data:plan": "tsx scripts/build-snapshot.ts",
    "data:check": "tsx scripts/build-snapshot.ts --check",
    "data:audit-coverage": "tsx scripts/audit-source-coverage.ts",
    "verify:browser": "node scripts/verify-gameplay.mjs",
    "validate:data": "tsx scripts/validate-data.ts",
    "build": "npm run typecheck && npm run validate:data && vite build",
    "preview": "vite preview",
    "format": "prettier --write src scripts docs data '*.json' '*.ts' index.html .github",
    "format:check": "prettier --check src scripts docs data '*.json' '*.ts' index.html .github"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
