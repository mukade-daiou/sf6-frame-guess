  "url": "https://frame-search.com/guide?lang=en-us",
  "retrievedAt": "2026-11-05T15:24:35.012Z",
  "status": 200,
  "finalUrl": "https://frame-search.com/guide?lang=en-us",
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n  <title>Feature Guide | SF6 Frame Data Search</title>\n  <link rel=\"icon\" href=\"/fds_ico.ico\">\n  <meta name=\"robots\" content=\"noindex\">\n  <link rel=\"stylesheet\" href=\"/css/fds-theme.css?v=1\">\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap\">\n  <script>(function(){var t=localStorage.getItem('fds-theme');if(t==='light'||t==='dark'||t==='nord'||t==='one-light'||t==='tokyo-night-light')document.documentElement.dataset.theme=t;})()</script>\n  <style>\n    :root {\n      --g-accent:  #e8701a;\n      --font-head: 'Rajdhani', 'Noto Sans JP', sans-serif;\n      --font-body: 'Noto Sans JP', sans-serif;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; }\n    body {\n      background: var(--fds-bg-page);\n      color: var(--fds-text-primary);\n      font-family: var(--font-body);\n      font-size: 15px;\n      line-height: 1.7;\n    }\n    a { color: var(--fds-link-color); }\n\n    .site-header {\n      background: linear-gradient(135deg, var(--fds-bg-page) 0%, var(--fds-bg-card) 100%);\n      border-bottom: 1px solid var(--fds-border);\n      padding: 48px 24px 40px;\n      text-align: center;\n      position: relative;\n      overflow: hidden;\n    }\n    .site-header::before {\n      content: '';\n      position: absolute;\n      inset: 0;\n      background: repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(232,112,26,0.04) 40px, rgba(232,112,26,0.04) 41px);\n      pointer-events: none;\n    }\n    .header-eyebrow {\n      font-family: var(--font-head);\n      font-size: 0.78em;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--g-accent);\n      margin-bottom: 10px;\n    }\n    .header-title {\n      font-family: var(--font-head);\n      font-size: clamp(2.2rem, 6vw, 3.4rem);\n      font-weight: 700;\n      line-height: 1.1;\n      letter-spacing: 0.04em;\n      margin: 0 0 12px;\n      text-wrap: balance;\n      color: var(--fds-header-text, var(--fds-text-primary));\n    }\n    .header-title span { color: var(--g-accent); }\n    .header-sub { color: var(--fds-text-secondary); font-size: 0.95em; max-width: 520px; margin: 0 auto; text-wrap: balance; }\n    .header-url {\n      display: inline-block;\n      margin-top: 18px;\n      padding: 7px 18px;\n      border: 1px solid var(--fds-border);\n      border-radius: 6px;\n      font-family: monospace;\n      font-size: 0.85em;\n      color: var(--fds-link-color);\n      background: var(--fds-glass-bg);\n      letter-spacing: 0.02em;\n      text-decoration: none;\n    }\n    .theme-btn {\n      position: absolute;\n      top: 14px;\n      right: 16px;\n      padding: 4px 10px;\n      border: 1px solid var(--fds-theme-btn-border, var(--fds-border));\n      border-radius: 20px;\n      font-size: 1em;\n      font-family: inherit;\n      background: var(--fds-theme-btn-bg, var(--fds-bg-card));\n      color: var(--fds-theme-btn-color, var(--fds-text-primary));\n      cursor: pointer;\n      min-width: 2.4em;\n      text-align: center;\n    }\n\n    .nav-pills {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 6px;\n      justify-content: center;\n      padding: 16px 24px;\n      border-bottom: 1px solid var(--fds-border);\n      background: var(--fds-bg-card);\n      position: sticky;\n      top: 0;\n      z-index: 10;\n    }\n    .pill {\n      padding: 4px 14px;\n      border-radius: 99px;\n      border: 1px solid var(--fds-border);\n      font-size: 0.8em;\n      color: var(--fds-text-secondary);\n      cursor: pointer;\n      background: transparent;\n      transition: border-color 0.15s, color 0.15s, background 0.15s;\n      font-family: var(--font-body);\n    }\n    .pill:hover { border-color: var(--g-accent); color: var(--g-accent); }\n    .pill.active { border-color: var(--g-accent); color: var(--g-accent); background: rgba(232,112,26,0.1); }\n\n    .main { max-width: 900px; margin: 0 auto; padding: 40px 24px 80px; }\n\n    .section { margin-bottom: 56px; }\n    .section-label { font-family: var(--font-head); font-size: 0.72em; letter-spacing: 0.16em; text-transform: uppercase; color: var(--g-accent); margin-bottom: 6px; }\n    .section-title { font-family: var(--font-head); font-size: 1.7em; font-weight: 700; margin: 0 0 16px; text-wrap: balance; line-height: 1.2; color: var(--fds-header-text, var(--fds-text-primary)); }\n    .section-desc { color: var(--fds-text-secondary); margin-bottom: 24px; max-width: 640px; }\n\n    .feature-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }\n    .feat { background: var(--fds-bg-card); border: 1px solid var(--fds-border); border-radius: 8px; padding: 18px 20px; transition: border-color 0.15s; }\n    .feat:hover { border-color: var(--fds-link-color); }\n    .feat-icon { font-size: 1.6em; margin-bottom: 10px; line-height: 1; }\n    .feat-name { font-weight: 700; font-size: 1em; margin-bottom: 6px; color: var(--fds-active-text, var(--fds-text-primary)); }\n    .feat-desc { font-size: 0.85em; color: var(--fds-text-secondary); line-height: 1.6; }\n\n    .steps { display: flex; flex-direction: column; gap: 16px; }\n    .step { display: flex; gap: 16px; align-items: flex-start; background: var(--fds-bg-card); border: 1px solid var(--fds-border); border-radius: 8px; padding: 16px 20px; }\n    .step-num { flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--g-accent); color: #fff; font-family: var(--font-head); font-weight: 700; font-size: 0.9em; display: flex; align-items: center; justify-content: center; margin-top: 1px; }\n    .step-body { flex: 1; min-width: 0; }\n    .step-title { font-weight: 700; margin-bottom: 4px; color: var(--fds-active-text, var(--fds-text-primary)); }\n    .step-text { font-size: 0.88em; color: var(--fds-text-secondary); line-height: 1.6; }\n\n    .frame-demo { background: var(--fds-bg-card); border: 1px solid var(--fds-border); border-radius: 8px; overflow: hidden; }\n    .frame-demo-head { background: var(--fds-dialog-bg, var(--fds-bg-page)); border-bottom: 1px solid var(--fds-border); padding: 10px 16px; font-size: 0.78em; color: var(--fds-text-secondary); font-family: monospace; letter-spacing: 0.04em; }\n    .frame-table { width: 100%; border-collapse: collapse; font-size: 0.88em; }\n    .frame-table th { padding: 8px 12px; text-align: center; font-size: 0.78em; color: var(--fds-text-secondary); letter-spacing: 0.06em; border-bottom: 1px solid var(--fds-border); font-weight: 500; }\n    .frame-table td { padding: 9px 12px; text-align: center; border-bottom: 1px solid var(--fds-modal-border, var(--fds-border)); font-variant-numeric: tabular-nums; color: var(--fds-text-primary); }\n    .frame-table tr:last-child td { border-bottom: none; }\n    .frame-table td.name { text-align: left; font-size: 0.92em; }\n    .num-good { color: var(--fds-adv-color); font-weight: 700; }\n    .num-bad  { color: var(--fds-dis-color); font-weight: 700; }\n    .num-neu  { color: var(--fds-text-primary); font-weight: 700; }\n    .badge-tag { display: inline-block; padding: 1px 7px; border-radius: 99px; font-size: 0.78em; font-weight: 500; border: 1px solid; }\n\n    .abbr-demo { background: var(--fds-bg-card); border: 1px solid var(--fds-border); border-radius: 8px; padding: 16px 20px; font-size: 0.88em; }\n    .abbr-row { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--fds-modal-border, var(--fds-border)); }\n    .abbr-row:last-child { border-bottom: none; }\n    .abbr-from { color: var(--fds-text-secondary); flex: 1; min-width: 0; }\n    .abbr-arrow { color: var(--fds-border); flex-shrink: 0; }\n    .abbr-to { color: var(--g-accent); font-weight: 700; font-family: var(--font-head); font-size: 1.05em; }\n\n    .share-demo { background: var(--fds-bg-card); border: 1px solid var(--fds-border); border-radius: 8px; padding: 16px 20px; }\n    .share-url { display: flex; align-items: center; gap: 8px; background: var(--fds-dialog-bg, var(--fds-bg-page)); border: 1px solid var(--fds-border); border-radius: 6px; padding: 8px 12px; font-family: monospace; font-size: 0.8em; color: var(--fds-link-color); overflow-x: auto; }\n    .share-icon { color: var(--fds-text-secondary); flex-shrink: 0; }\n\n    .divider { border: none; border-top: 1px solid var(--fds-border); margin: 48px 0; }\n    .tip { background: var(--fds-hover-bg); border: 1px solid rgba(83,155,245,0.25); border-radius: 8px; padding: 14px 18px; font-size: 0.88em; color: var(--fds-text-secondary); line-height: 1.6; margin-top: 16px; }\n    .tip strong { color: var(--fds-link-hover, var(--fds-link-color)); }\n\n    .footer { text-align: center; padding: 32px 24px; border-top: 1px solid var(--fds-border); color: var(--fds-text-secondary); font-size: 0.82em; }\n    .footer a { color: var(--fds-link-color); text-decoration: none; }\n\n    @media (max-width: 600px) { .feature-grid { grid-template-columns: 1fr; } }\n    @media (prefers-reduced-motion: reduce) { .feat, .pill { transition: none; } }\n  </style>\n</head>\n<body>\n\n<header class=\"site-header\">\n  <button class=\"theme-btn\" id=\"guide-theme-btn\" onclick=\"_guideThemeCycle()\" aria-label=\"Toggle theme\"></button>\n  <div class=\"header-eyebrow\">frame-search.com</div>\n  <h1 class=\"header-title\">SF6 Frame Data <span>Search</span><br>Feature Guide</h1>\n  <p class=\"header-sub\">Search and compare move data across all SF6 characters. An overview of tools to support your frame-by-frame research.</p>\n  <a class=\"header-url\" href=\"/\">https://frame-search.com</a>\n</header>\n\n<nav class=\"nav-pills\" aria-label=\"Sections\">\n  <button class=\"pill active\" onclick=\"scrollToSection('s-search')\">Search</button>\n  <button class=\"pill\" onclick=\"scrollToSection('s-filter')\">Filters</button>\n  <button class=\"pill\" onclick=\"scrollToSection('s-tag')\">Tags</button>\n  <button class=\"pill\" onclick=\"scrollToSection('s-abbr')\">Abbr. Dict.</button>\n  <button class=\"pill\" onclick=\"scrollToSection('s-manage')\">Move Mgmt</button>\n  <button class=\"pill\" onclick=\"scrollToSection('s-share')\">Share</button>\n  <button class=\"pill\" onclick=\"scrollToSection('s-mobile')\">Mobile</button>\n</nav>\n\n<main class=\"main\">\n\n  <section class=\"section\" id=\"s-search\">\n    <div class=\"section-label\">Core Feature</div>\n    <h2 class=\"section-title\">Search by Frame Data</h2>\n    <p class=\"section-desc\">Filter moves by startup, recovery, hit advantage, and block advantage. Stack multiple conditions — for example \"startup ≤ 7\" and \"block ≤ −4\" — to pinpoint exactly what you need.</p>\n    <div class=\"frame-demo\">\n      <div class=\"frame-demo-head\">Results — Startup ≤ 7 / All characters</div>\n      <div style=\"overflow-x:auto;\">\n        <table class=\"frame-table\">\n          <thead><tr><th style=\"text-align:left;\">Move</th><th>Su</th><th>Re</th><th>Hit</th><th>Block</th></tr></thead>\n          <tbody>\n            <tr><td class=\"name\">Standing LP</td><td class=\"num-neu\">4</td><td class=\"num-neu\">12</td><td class=\"num-good\">+3</td><td class=\"num-bad\">−2</td></tr>\n            <tr><td class=\"name\">Standing LK</td><td class=\"num-neu\">5</td><td class=\"num-neu\">14</td><td class=\"num-good\">+5</td><td class=\"num-bad\">−1</td></tr>\n            <tr><td class=\"name\">Drive Impact</td><td class=\"num-neu\">6</td><td class=\"num-neu\">24</td><td class=\"num-good\">KD</td><td class=\"num-good\">+5</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n    <div class=\"tip\"><strong>Tip:</strong> Set an upper limit on startup to find your fastest punishes, or set block to \"≤ −4\" to see every move you can punish on block.</div>\n  </section>\n\n  <hr class=\"divider\">\n\n  <section class=\"section\" id=\"s-filter\">\n    <div class=\"section-label\">Filtering</div>\n    <h2 class=\"section-title\">Character &amp; Category Filters</h2>\n    <p class=\"section-desc\">Pick a character from the picker at the top of the page. Narrow down further by move category — normals, specials, Super Arts, and more.</p>\n    <div class=\"feature-grid\">\n      <div class=\"feat\"><div class=\"feat-icon\">🎮</div><div class=\"feat-name\">Full Roster</div><div class=\"feat-desc\">Data for every playable character in SF6, updated with each patch.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">🗂</div><div class=\"feat-name\">Category Filter</div><div class=\"feat-desc\">Filter by Normals, Specials, SA1–3, and more to narrow your focus.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">🔄</div><div class=\"feat-name\">Patch Diff Highlights</div><div class=\"feat-desc\">Values changed in the latest patch are highlighted, so you can spot balance changes instantly.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">🎯</div><div class=\"feat-name\">Modern Controls Commands</div><div class=\"feat-desc\">Each move shows its Modern controls command alongside the Classic one, so you can check both at a glance.</div></div>\n    </div>\n  </section>\n\n  <hr class=\"divider\">\n\n  <section class=\"section\" id=\"s-tag\">\n    <div class=\"section-label\">Organization</div>\n    <h2 class=\"section-title\">Color-Code Moves with Tags</h2>\n    <p class=\"section-desc\">Create custom tags to categorize moves your own way — moves you're labbing, punishes to learn, threats to watch out for. Each tag has a name and color you pick.</p>\n    <div class=\"steps\">\n      <div class=\"step\"><div class=\"step-num\">1</div><div class=\"step-body\"><div class=\"step-title\">Tap +TAG on a move</div><div class=\"step-text\">Every move row has a +TAG button. Tap it to open the tag picker for that move.</div></div></div>\n      <div class=\"step\"><div class=\"step-num\">2</div><div class=\"step-body\"><div class=\"step-title\">Create and assign</div><div class=\"step-text\">Set a name and color to create a new tag, then assign it to the move right away.</div></div></div>\n      <div class=\"step\"><div class=\"step-num\">3</div><div class=\"step-body\"><div class=\"step-title\">Filter by tag</div><div class=\"step-text\">Turn on the tag filter to show only moves with that tag.</div></div></div>\n    </div>\n    <div style=\"margin-top:16px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;\">\n      <span class=\"badge-tag\" style=\"color:#58a6ff;border-color:#58a6ff;background:rgba(88,166,255,0.1);\">Labbing</span>\n      <span class=\"badge-tag\" style=\"color:#3fb950;border-color:#3fb950;background:rgba(63,185,80,0.1);\">Punish</span>\n      <span class=\"badge-tag\" style=\"color:#e8701a;border-color:#e8701a;background:rgba(232,112,26,0.1);\">Watch out</span>\n      <span class=\"badge-tag\" style=\"color:#bc8cff;border-color:#bc8cff;background:rgba(188,140,255,0.1);\">Okizeme</span>\n      <span style=\"font-size:0.82em;color:var(--fds-text-secondary);\">← fully customizable</span>\n    </div>\n    <div class=\"tip\" style=\"margin-top:16px;\"><strong>System tags:</strong> The <strong style=\"color:#991b1b;\">Modern</strong> tag filters moves available in Modern controls, and <strong style=\"color:#6366f1;\">Classic Only</strong> shows moves unavailable in Modern. Both are available in the tag filter bar.</div>\n  </section>\n\n  <hr class=\"divider\">\n\n  <section class=\"section\" id=\"s-abbr\">\n    <div class=\"section-label\">Display</div>\n    <h2 class=\"section-title\">Abbreviation Dictionary</h2>\n    <p class=\"section-desc\">Automatically replaces long move names with FGC shorthand. \"Tatsumaki Zanku-kyaku → Tatsu\", \"Drive Impact → DI\". Build your own ruleset or start from the built-in presets.</p>\n    <div class=\"abbr-demo\">\n      <div class=\"abbr-row\"><span class=\"abbr-from\">Tatsumaki Zanku-kyaku</span><span class=\"abbr-arrow\">→</span><span class=\"abbr-to\">Tatsu</span></div>\n      <div class=\"abbr-row\"><span class=\"abbr-from\">Drive Impact</span><span class=\"abbr-arrow\">→</span><span class=\"abbr-to\">DI</span></div>\n      <div class=\"abbr-row\"><span class=\"abbr-from\">Shoryuken</span><span class=\"abbr-arrow\">→</span><span class=\"abbr-to\">DP</span></div>\n      <div class=\"abbr-row\"><span class=\"abbr-from\">Screw Piledriver</span><span class=\"abbr-arrow\">→</span><span class=\"abbr-to\">SPD</span></div>\n      <div class=\"abbr-row\"><span class=\"abbr-from\">Spinning Bird Kick</span><span class=\"abbr-arrow\">→</span><span class=\"abbr-to\">SBK</span></div>\n    </div>\n    <div class=\"tip\"><strong>Note:</strong> Restoring the default presets keeps any rules you added yourself — only the preset entries are refreshed.</div>\n  </section>\n\n  <hr class=\"divider\">\n\n  <section class=\"section\" id=\"s-manage\">\n    <div class=\"section-label\">Personal Settings</div>\n    <h2 class=\"section-title\">Move Management</h2>\n    <p class=\"section-desc\">Pin or star moves you reference often to keep them at the top. Hide irrelevant moves with the exclusion list for a cleaner view. Everything is saved in your browser.</p>\n    <div class=\"feature-grid\">\n      <div class=\"feat\"><div class=\"feat-icon\">📌</div><div class=\"feat-name\">Pin</div><div class=\"feat-desc\">Lock a move to the top of results. Persists when you switch characters.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">⭐️</div><div class=\"feat-name\">Favorites (★)</div><div class=\"feat-desc\">Star moves and filter to see only your favorites at a glance.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">🗑</div><div class=\"feat-name\">Exclusion List</div><div class=\"feat-desc\">Hide moves you don't need. Keep the list focused on what matters to you.</div></div>\n    </div>\n  </section>\n\n  <hr class=\"divider\">\n\n  <section class=\"section\" id=\"s-share\">\n    <div class=\"section-label\">Sharing</div>\n    <h2 class=\"section-title\">Share Your Setup</h2>\n    <p class=\"section-desc\">Export your tags, pins, favorites, exclusion list, and abbreviation rules to a short URL. Share it with teammates, post it to socials, or load it on another device.</p>\n    <div class=\"share-demo\">\n      <div style=\"font-size:0.85em;color:var(--fds-text-secondary);margin-bottom:12px;\">Example share URL (expires after a set period)</div>\n      <div class=\"share-url\">\n        <svg class=\"share-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M7.775 3.275a.75.75 0 001.06 1.06l1.25-1.25a2 2 0 112.83 2.83l-2.5 2.5a2 2 0 01-2.83 0 .75.75 0 00-1.06 1.06 3.5 3.5 0 004.95 0l2.5-2.5a3.5 3.5 0 00-4.95-4.95l-1.25 1.25zm-4.69 9.64a2 2 0 010-2.83l2.5-2.5a2 2 0 012.83 0 .75.75 0 001.06-1.06 3.5 3.5 0 00-4.95 0l-2.5 2.5a3.5 3.5 0 004.95 4.95l1.25-1.25a.75.75 0 00-1.06-1.06l-1.25 1.25a2 2 0 01-2.83 0z\"/></svg>\n        frame-search.com/?import=aBcDeFgH1234\n      </div>\n      <div class=\"tip\" style=\"margin-top:12px;\"><strong>What's included:</strong> Tags, pins, favorites, exclusion list, abbreviation rules. Frame data itself is not included.</div>\n    </div>\n  </section>\n\n  <hr class=\"divider\">\n\n  <section class=\"section\" id=\"s-mobile\">\n    <div class=\"section-label\">Platform</div>\n    <h2 class=\"section-title\">Mobile Version</h2>\n    <p class=\"section-desc\">A dedicated mobile UI optimized for phones. Swipe through moves vertically and tap to expand frame details and GIF animations — great for quick lookups mid-session.</p>\n    <div class=\"feature-grid\">\n      <div class=\"feat\"><div class=\"feat-icon\">📱</div><div class=\"feat-name\">Phone-Optimized UI</div><div class=\"feat-desc\">Scroll through moves vertically. Tap a row to expand details and animations.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">📋</div><div class=\"feat-name\">List View</div><div class=\"feat-desc\">See moves from multiple characters in a compact list — useful for matchup research.</div></div>\n      <div class=\"feat\"><div class=\"feat-icon\">⚡️</div><div class=\"feat-name\">PWA Install</div><div class=\"feat-desc\">Add to your home screen and launch like an app on iOS and Android.</div></div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"footer\">\n  <p style=\"margin-bottom:12px;\">\n    <a href=\"/usage_en-us.html\" target=\"_blank\" style=\"border:1px solid var(--fds-border);border-radius:6px;padding:6px 16px;font-size:0.88em;text-decoration:none;color:var(--fds-link-color);\">Getting Started: Matchup Study Guide →</a>\n  </p>\n  <p>SF6 Frame Data Search &nbsp;·&nbsp; <a href=\"/?lang=en-us\">frame-search.com</a></p>\n  <p style=\"margin-top:4px;\">Data sourced from Capcom's official information.</p>\n</footer>\n\n<script>\nfunction scrollToSection(id) {\n  document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });\n  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));\n  const map = {'s-search':0,'s-filter':1,'s-tag':2,'s-abbr':3,'s-manage':4,'s-share':5,'s-mobile':6};\n  const idx = map[id];\n  if (idx !== undefined) document.querySelectorAll('.pill')[idx]?.classList.add('active');\n}\n\nconst _sectionIds = ['s-search','s-filter','s-tag','s-abbr','s-manage','s-share','s-mobile'];\nconst _observer = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));\n      const idx = _sectionIds.indexOf(e.target.id);\n      if (idx !== -1) document.querySelectorAll('.pill')[idx]?.classList.add('active');\n    }\n  });\n}, { rootMargin: '-40% 0px -55% 0px' });\n_sectionIds.forEach(id => { const el = document.getElementById(id); if (el) _observer.observe(el); });\n\nfunction _guideThemeUpdateBtn() {\n  var b = document.getElementById('guide-theme-btn');\n  if (!b) return;\n  var d = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');\n  var icons = {dark:'☀',light:'○','one-light':'◑','tokyo-night-light':'❄',nord:'☾'};\n  var titles = {dark:'Switch to Light',light:'Switch to One Light','one-light':'Switch to Tokyo Night Light','tokyo-night-light':'Switch to Nord',nord:'Switch to Dark'};\n  b.textContent = icons[d] || '☀';\n  b.title = titles[d] || 'Toggle theme';\n}\nfunction _guideThemeCycle() {\n  var d = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');\n  var cycle = {dark:'light',light:'one-light','one-light':'tokyo-night-light','tokyo-night-light':'nord',nord:'dark'};\n  var n = cycle[d] || 'light';\n  document.documentElement.dataset.theme = n;\n  try { localStorage.setItem('fds-theme', n); } catch(e) {}\n  _guideThemeUpdateBtn();\n}\n_guideThemeUpdateBtn();\n</script>\n</body>\n</html>\n"
}
