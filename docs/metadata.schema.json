{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "updatePolicy": {
      "type": "string",
      "const": "manual"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "enum": ["production", "fixture"]
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["schemaVersion", "kind", "gameVersion", "label"],
  "additionalProperties": false
}
